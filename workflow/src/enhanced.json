    {
      "dot": "cyan",
      "title": "The three classes",
      "items": [
        "abs: absolute configuration known",
        "or: one stereoisomer, unknown which",
        "and: mixture with the mirror image (racemic)"
      ]
    },
    {
      "dot": "emerald",
      "title": "Read the examples",
      "items": [
        "Row 1 abs: /t4-/m0/s1, as standard InChI",
        "Row 2 or: /t4-/s2, no /m: enantiomer unknown",
        "Row 3 and: /t4-/s3, the racemate",
        "Row 9 abs + or: /t2-,3-/m1/s1(2)2(3)"
      ]
    },
    {
      "dot": "violet",
      "title": "Several molecules",
      "items": [
        "/t, /m, /s: one ';' slot per molecule",
        "/s;3: first absolute, second racemic",
        "A group over two molecules is rejected (row 18)"
      ]
    },
    {
      "dot": "amber",
      "title": "Why normalise",
      "items": [
        "or / and groups: lowest centre written '-'",
        "Both drawings of a racemate give one InChI"
      ]
    }
  ]
